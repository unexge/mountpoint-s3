[global]
name=fs_bench
bs=256k
runtime=30s
time_based
group_reporting

[random_read_1G_4_threads]
size=1G
rw=randread
ioengine=sync
fallocate=none
numjobs=4

[random_read_5M_4_threads]
wait_for_previous
size=5M
rw=randread
ioengine=sync
fallocate=none
numjobs=4

[random_read_1G_32_threads]
wait_for_previous
size=1G
rw=randread
ioengine=sync
fallocate=none
numjobs=32

[random_read_5M_32_threads]
wait_for_previous
size=5M
rw=randread
ioengine=sync
fallocate=none
numjobs=32

[seq_read_5M_4_threads]
wait_for_previous
size=5M
rw=read
ioengine=sync
fallocate=none
numjobs=4

[seq_read_5M_32_threads]
wait_for_previous
size=5M
rw=read
ioengine=sync
fallocate=none
numjobs=32
